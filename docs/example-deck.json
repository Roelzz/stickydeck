        { "label": "Whiteboard", "icon": "whiteboard", "action": { "type": "keys", "keys": ["W"] } },
        { "label": "Text",       "icon": "text",       "action": { "type": "keys", "keys": ["T"] } },
        { "label": "Zoom",       "icon": "zoom",       "action": { "type": "keys", "mods": ["CTRL"], "keys": ["Z"] } }
